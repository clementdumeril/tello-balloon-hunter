Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Cell Size: 0.5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Marker Scale: 0.3
    - Class: rviz_default_plugins/MarkerArray
      Name: Markers
      Enabled: true
      Topic:
        Value: /aruco/map_markers
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Image
      Name: ArUco debug
      Enabled: true
      Topic:
        Value: /aruco/debug_image
  Global Options:
    Fixed Frame: map
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 7
      Focal Point: {X: 2, Y: 1.75, Z: 0.8}
      Pitch: 0.7
      Yaw: 3.9
Window Geometry:
  Width: 1400
  Height: 900
