Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Reference Frame: map
      Cell Size: 0.5
      Offset: {X: 0, Y: 0, Z: 0}
      Plane Cell Count: 10
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Arrows: false
      Marker Scale: 0.3
    - Class: rviz_default_plugins/Marker
      Name: Room (3D scan)
      Enabled: true
      Topic:
        Value: /room/mesh
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/MarkerArray
      Name: ArUco markers
      Enabled: true
      Topic:
        Value: /aruco/map_markers
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/MarkerArray
      Name: Drone (body + camera view)
      Enabled: true
      Topic:
        Value: /tello/body_markers
        Durability Policy: Transient Local
    - Class: rviz_default_plugins/Marker
      Name: Markers seen now (green lines)
      Enabled: true
      Topic:
        Value: /aruco/sight_lines
    - Class: rviz_default_plugins/Path
      Name: Drone trajectory
      Enabled: true
      Topic:
        Value: /aruco/path
      Color: 255; 170; 0
      Line Style: Billboards
      Line Width: 0.02
    - Class: rviz_default_plugins/PoseWithCovariance
      Name: ArUco pose (raw)
      Enabled: false
      Topic:
        Value: /aruco/pose
      Shape: Axes
      Axes Length: 0.3
      Axes Radius: 0.03
      Covariance:
        Value: false
    - Class: rviz_default_plugins/Image
      Name: Tello camera (detections)
      Enabled: true
      Topic:
        Value: /aruco/debug_image
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 6
      Focal Point: {X: 1.5, Y: 1.5, Z: 0.8}
      Pitch: 0.65
      Yaw: 3.9
Window Geometry:
  Width: 1200
  Height: 700
