<?xml version="1.0"?>
<package format="3">
  <name>tello_driver</name>
  <version>0.1.0</version>
  <description>ROS 2 driver for the DJI Tello (djitellopy): same topics as the simulator, keyboard teleop, real-drone launch with RViz.</description>
  <maintainer email="team@example.com">tello-balloon-hunter team</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>aruco_localization</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
